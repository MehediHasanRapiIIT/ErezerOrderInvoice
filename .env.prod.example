# ============================================================================
# EREZER admin panel - PRODUCTION environment
# Lives ONLY on the VPS, at /opt/erezer-invoice/.env  (chmod 600). Never commit it.
#
# CI overwrites the compose files and deploy scripts on every deploy but never
# touches .env, so the VPS stays the only owner of its secrets.
#
# Generate secrets on the VPS:
#   openssl rand -base64 48 | tr -d '\n'     (JWT_SECRET)
#   openssl rand -base64 32                  (COURIER_ENCRYPTION_KEY - must be exactly this)
#   openssl rand -hex 24                     (passwords)
# ============================================================================

# ── Images (CI sets IMAGE_TAG per deploy; this is the fallback for manual runs) ──
IMAGE_REPO_OWNER=CHANGE_ME_dockerhub_username
IMAGE_TAG=latest

# ── Public address ──────────────────────────────────────────────────────────
# Bare hostname, no https://. DNS for it AND for www.<it> must point at this VPS.
PANEL_HOST=erezer.site

# Where the shop's Caddy reads extra site files, and its container name.
# Defaults match the shop deployed in /opt/erezer; change only if yours differ.
CADDY_SITES_DIR=/opt/erezer/sites
CADDY_CONTAINER=erezer-caddy

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=erezer
POSTGRES_USER=erezer
POSTGRES_PASSWORD=CHANGE_ME

# ── Object storage (MinIO, product images) ─────────────────────────────────
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_ROOT_USER=erezer-root
MINIO_ROOT_PASSWORD=CHANGE_ME
# Least-privilege user the backend uses (created by minio-init).
STORAGE_ACCESS_KEY=erezer-app
STORAGE_SECRET_KEY=CHANGE_ME
# Must stay "erezer": the panel's nginx serves image links under /erezer/.
STORAGE_BUCKET=erezer

# ── Security ───────────────────────────────────────────────────────────────
# Signs login tokens. Changing it logs everyone out.
JWT_SECRET=CHANGE_ME
# Encrypts the saved Steadfast API keys. KEEP A COPY SOMEWHERE SAFE: if it is
# lost or changed, the keys must be entered again in Courier settings.
COURIER_ENCRYPTION_KEY=CHANGE_ME

# First admin, created on the first start only (when no admin exists).
# Password: 10+ characters with a letter and a digit. Change it after the first login.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@erezer.site
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ── Company details printed on invoices ────────────────────────────────────
COMPANY_NAME=EREZER
COMPANY_ADDRESS=Opposite of Dhaka Commerce College, Mirpur-2, Dhaka
COMPANY_PHONE=01786141187
COMPANY_EMAIL=contact.erezer@gmail.com
COMPANY_INVOICE_FOOTER=Thank you for shopping with EREZER!

# ── Memory caps (this VPS also runs the shop) ──────────────────────────────
BACKEND_MEM_LIMIT=900m
POSTGRES_MEM_LIMIT=512m
MINIO_MEM_LIMIT=384m
FRONTEND_MEM_LIMIT=128m

# ── Backups ────────────────────────────────────────────────────────────────
# Nightly pg_dump into the backup-data volume ON THIS VPS. Copy them off the
# server regularly (see DEPLOYMENT.md, "Backups").
BACKUP_RETENTION_DAYS=14
