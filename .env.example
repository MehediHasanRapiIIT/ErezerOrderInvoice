# Copy to .env and fill in. NEVER commit .env.
# The defaults below match the backend "dev" profile, so `docker compose up -d postgres minio minio-init`
# works with `./mvnw spring-boot:run` out of the box. Replace every secret for production.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=erezer
POSTGRES_USER=erezer
POSTGRES_PASSWORD=erezer

# --- Object storage (MinIO) ------------------------------------------------
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=erezer-root
MINIO_ROOT_PASSWORD=erezer-root-dev-secret
# Least-privilege user the backend uses (created by minio-init)
STORAGE_ACCESS_KEY=erezer
STORAGE_SECRET_KEY=erezer-dev-secret
STORAGE_BUCKET=erezer
# URL browsers use to load images (presigned links). Must be reachable from the user's browser.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9010

# --- Security ---------------------------------------------------------------
# Generate a fresh one for production: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1kZXYtb25seS1zZWNyZXQtY2hhbmdlLW1l
# true in production (HTTPS). Browsers also accept Secure cookies on http://localhost.
REFRESH_COOKIE_SECURE=true

# First admin, created only when no admin exists yet. Password: 10+ chars, a letter and a digit.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@erezer.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345678

# --- Company details printed on invoices ------------------------------------
COMPANY_NAME=EREZER
COMPANY_ADDRESS=Opposite of Dhaka Commerce College, Mirpur-2, Dhaka
COMPANY_PHONE=01708697257
COMPANY_EMAIL=contact@erezer.com
COMPANY_INVOICE_FOOTER=Thank you for shopping with EREZER!

# --- Ports ------------------------------------------------------------------
HTTP_PORT=8088
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
